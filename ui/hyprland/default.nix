# =====================================================================
# ui/hyprland/ — ось «Hyprland». Подключается при kda.opts.ui = "hyprland".
#
# Рабочий каркас под миграцию с KDE:
# композитор, лончер (walker), уведомления, бары — типовой стек.
# При переходе устройства достаточно поменять kda.opts.ui = "hyprland"
# и перенести пользовательские конфиги в home-слой.
#
# Карта миграции компонентов KDE -> Hyprland см. в guide.md (раздел
# «Миграция на Hyprland»).
#
# ФОРМАТ: attrset с `imports`, а не список путей (см. комментарий в
# ui/kde/default.nix — тот же класс ошибки «does not look like a module»).
# =====================================================================
{
  imports = [
    ./hyprland.nix
  ];
}

{
  config,
  lib,
  pkgs,
  ...
}: {
  # =====================================================================
  # ByeDPI — локальный SOCKS-прокси для обхода DPI.
  #
  # Сервис слушает на 127.0.0.1:6430 и применяет стратегии
  # десинхронизации TCP только к доменам из списка /etc/byedpi/hosts.txt.
  # Остальной трафик (в том числе банки, госуслуги) идёт без изменений.
  #
  # Подключение Brave:
  #   браузер запускается с --proxy-server="socks5://127.0.0.1:6430".
  #   Это делается в home-manager (см. отдельный файл).
  #
  # ВАЖНО:
  # - ByeDPI — это SOCKS5-прокси, он не перехватывает трафик
  #   глобально. Только приложения, явно указавшие прокси, идут через него.
  # - sing-box и dnscrypt-proxy продолжают работать независимо.
  #   Если Brave должен идти через VLESS, а не через ByeDPI,
  #   уберите --proxy-server из его запуска (или переопределите правило
  #   в route.rules sing-box, добавив process_name = ["brave"]).
  # =====================================================================
  services.byedpi = {
    enable = true;

    # Порт 6430, как запрошено. По умолчанию ByeDPI слушает 1080.
    # --hosts ограничивает область действия стратегий списком доменов.
    # Без --hosts стратегии применяются ко всем соединениям.
    extraArgs = [
      "-p" "6430"
      "--hosts" "/etc/byedpi/hosts.txt"
      # Стратегии обхода DPI. Подобраны как базовый рабочий набор
      # для российских провайдеров. Если что-то не работает —
      # можно добавить/заменить параметры, примеры в README ByeDPI.
      "--disorder" "1"
      "--auto=torst"
      "--tlsrec" "1+s"
    ];
  };

  # =====================================================================
  # Файл с доменами для обхода DPI.
  #
  # Каждая строка — один домен. ByeDPI применит стратегии
  # только к соединениям, в которых SNI (для HTTPS) или Host
  # (для HTTP) совпадает с одним из этих доменов.
  #
  # Сейчас список пуст — добавьте свои домены. Пример:
  #   youtube.com
  #   googlevideo.com
  #   discord.com
  #
  # Если оставить файл пустым, ByeDPI будет применять стратегии
  # ко ВСЕМ соединениям (поведение по умолчанию).
  # =====================================================================
  environment.etc."byedpi/hosts.txt".text = ''
    # Список доменов для обхода DPI.
    # Один домен на строку. Поддомены включаются автоматически.
    youtube.com
    googlevideo.com
    ytimg.com
    discord.com
    discordapp.com
    # Добавьте свои домены ниже:
  '';

  # =====================================================================
  # Автозапуск и зависимости сервиса.
  #
  # ByeDPI не требует nftables или TUN, но ему нужна сеть.
  # Ставим after = network-online.target, чтобы стартовал
  # после поднятия интерфейса.
  # =====================================================================
  systemd.services.byedpi = {
    after = [ "network-online.target" "nss-lookup.target" ];
    wants = [ "network-online.target" ];
    serviceConfig = {
      # Сервис уже описан в модуле nixpkgs, но мы явно
      # добавляем WantedBy, чтобы он стартовал при загрузке.
      WantedBy = [ "multi-user.target" ];
    };
  };
}

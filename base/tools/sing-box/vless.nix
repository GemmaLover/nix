# Конфиг vless-out для sing-box — ПОСТОЯННАЯ ЗАГЛУШКА (реального сервера нет).
# Файл намеренно закоммичен в git: signbox.nix импортирует его статически,
# а flake при сборке из git-дерева копирует только отслеживаемые файлы —
# untracked-файл был бы невидим для import и ломал бы сборку.
# Когда появится реальный сервер: включите enable = true и подставьте
# реальные данные (секреты тогда лучше вынести через sops/agenix, а не в git).
{
  enable = false;              # true — только при реальном сервере
  server = "REPLACE_ME";       # адрес/домен сервера
  port = 443;
  uuid = "REPLACE_ME";
  sni = "REPLACE_ME";          # TLS server_name
}

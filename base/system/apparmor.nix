{ config, lib, pkgs, ... }:

{
  # === AppArmor ===
  # Включаем AppArmor в режиме обучения.
  # В этом режиме нарушения только логируются, но не блокируются.
  # Это позволяет собрать профили без риска сломать систему.
  security.apparmor.enable = true;

  # Не убивать процессы, которые нарушают профили.
  # Это «режим обучения» — мы хотим видеть нарушения в логах,
  # но не хотим, чтобы система убивала приложения.
  security.apparmor.killUnconfinedConfinables = false;
}

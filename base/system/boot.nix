{ config, lib, pkgs, ... }:

{
  # =====================================================================
  # Загрузчик systemd-boot
  # =====================================================================
  # Используется на всех наших устройствах (UEFI).
  # systemd-boot проще, чем GRUB, и не требует указания диска
  # (в отличие от GRUB), потому что устанавливается в ESP
  # (EFI System Partition), которая уже смонтирована в /boot.
  boot.loader.systemd-boot.enable = true;

  # Разрешить NixOS изменять EFI-переменные загрузки.
  # Нужно, чтобы systemd-boot регистрировался как основной загрузчик
  # и обновлял записи при новых поколениях.
  boot.loader.efi.canTouchEfiVariables = true;

  # Храним только последние 10 поколений системы — экономит место в /boot.
  # Старые можно откатить при загрузке, но обычно хватает 10.
  boot.loader.systemd-boot.configurationLimit = 10;

  # =====================================================================
  # Параметры ядра (системные, не device-specific)
  # =====================================================================
  # ВАЖНО: этот список СКЛЕИВАЕТСЯ с boot.kernelParams из других модулей
  # (например, devices/z13/specific/kernel.nix добавляет сюда
  # amdgpu.gttsize, ttm.pages_limit и т.д.). NixOS для listOf str
  # по умолчанию объединяет определения из разных модулей.
  boot.kernelParams = [
    # ---------------------------------------------------------------------
    # SYSTEMD_SULOGIN_FORCE=1 — аварийный вход без «root is locked»
    # ---------------------------------------------------------------------
    # Контекст: если stage 2 падает в emergency mode, systemd запускает
    # sulogin. Если в /etc/shadow поле пароля root помечено как `!` или
    # `*` (аккаунт locked), sulogin ОТКАЗЫВАЕТСЯ даже спрашивать пароль
    # и сразу говорит «root is locked». В систему не попасть без ручной
    # правки cmdline в загрузчике.
    #
    # SYSTEMD_SULOGIN_FORCE=1 заставляет sulogin запуститься и СПРОСИТЬ
    # пароль независимо от того, помечен ли аккаунт как locked.
    #
    # ЧЕГО ЭТОТ ПАРАМЕТР НЕ ДЕЛАЕТ:
    #   - НЕ отключает аутентификацию.
    #   - НЕ даёт free root.
    #   - НЕ пускает без пароля.
    # Он только разрешает sulogin стартовать. Проверка пароля против
    # /etc/shadow остаётся на месте. Если пароль не подходит — Ctrl+D
    # продолжает загрузку, как обычно.
    #
    # Раньше этот параметр вбивался руками в GRUB (`e` → добавить
    # `single systemd.setenv=SYSTEMD_SULOGIN_FORCE=1`). Теперь он всегда
    # здесь — набирать руками больше не нужно.
    "systemd.setenv=SYSTEMD_SULOGIN_FORCE=1"

    # ---------------------------------------------------------------------
    # systemd.debug-shell — аварийный root-shell на Ctrl+Alt+F9
    # ---------------------------------------------------------------------
    # Даёт root-шелл БЕЗ пароля на девятой виртуальной консоли в любой
    # момент загрузки. Переключиться: Ctrl+Alt+F9, вернуться — Ctrl+Alt+F1.
    #
    # В ОТЛИЧИЕ от SYSTEMD_SULOGIN_FORCE, это ДЕЙСТВИТЕЛЬНО чёрный ход:
    # пароль не спрашивается вообще. При физическом доступе к ноутбуку
    # любой может получить root.
    #
    # Опция тут на случай, если забудешь пароль root и emergency не
    # пустит. Если такой сценарий не пугает или не нужен — закомментируй
    # строку, FORCE и emergencyAccess работают без неё.
    #"systemd.debug-shell"
  ];

  # =====================================================================
  # Пароль root задаётся в base/system/users.nix
  # =====================================================================
  # Здесь только пояснение, чтобы не задать его случайно второй раз.
  # Дублирование users.users.root.hashedPassword в двух файлах приводит
  # к ошибке `conflicting definition values` при nix flake check.

  # =====================================================================
  # emergencyAccess в initrd — страховка на стадии 1
  # =====================================================================
  # Отдельная история от SYSTEMD_SULOGIN_FORCE:
  #
  #   В initrd (до монтирования корня) у systemd СВОЙ /etc/shadow.
  #   Root в нём по умолчанию помечен как locked. Если авария случится
  #   именно там (LUKS не открывается, корень не найден), sulogin будет
  #   читать этот initrd-shadow, а не настоящий из системы.
  #
  #   SYSTEMD_SULOGIN_FORCE старту sulogin разрешит, но пароль всё равно
  #   не подойдёт — сравнивать не с чем.
  #
  # boot.initrd.systemd.emergencyAccess задаёт хэш пароля ИМЕННО для
  # initrd-shadow. Тогда в initrd emergency sulogin спросит пароль и
  # сверит его с этим значением.
  #
  # Хэш тот же, что у root в base/system/users.nix (в формате $6$,
  # sha512crypt — sulogin в initrd его гарантированно понимает;
  # yescrypt $y$ может не распознать).
  #
  # Получить новый хэш: openssl passwd -6 (спрашивает пароль дважды).
  # Экранировать `$` как `''$` не нужно — это обычная двойная кавычка
  # Nix, ${ тут не встречается.
  boot.initrd.systemd.emergencyAccess = "$6$V7DATbxGeLD62uWF$UHymFJn2.A0Tu0KYtpXC8OWUhkb546qSowpljSdKxVyThD0UoLAuOgaTYyIyzIL4IzR7tdlM2BA2sb.iyxlt9.";

  # =====================================================================
  # systemd в initrd (закомментировано — включить при переходе на гибернацию)
  # =====================================================================
  # Включает современный systemd-based initrd вместо legacy bash-скриптов.
  # Критически важно для корректной работы гибернации на LUKS:
  # systemd умеет правильно упорядочивать разблокировку шифрованных
  # устройств и resume из swap. Без этого возможны зависания при
  # пробуждении и долгая загрузка.
  #
  # Нюанс: если включишь — emergencyAccess выше должен быть заполнен,
  # иначе аварийный шелл в initrd будет недоступен.
  # boot.initrd.systemd.enable = true;

  # =====================================================================
  # Гибернация (закомментировано — включить вместе с systemd в initrd)
  # =====================================================================
  # powerManagement.enable = true;
}

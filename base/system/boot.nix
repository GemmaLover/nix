{ config, lib, pkgs, ... }:

{
  # =====================================================================
  # Загрузчик systemd-boot
  # =====================================================================
  # Используется на всех наших устройствах (UEFI).
  # systemd-boot проще, чем GRUB, и не требует указания диска
  # (в отличие от GRUB), потому что устанавливается в ESP
  # (EFI System Partition), которая уже смонтирована в /boot.
  boot.loader.systemd-boot.enable = true;

  # Разрешить NixOS изменять EFI-переменные загрузки.
  # Нужно, чтобы systemd-boot регистрировался как основной загрузчик
  # и обновлял записи при новых поколениях.
  boot.loader.efi.canTouchEfiVariables = true;

  # Храним только последние 10 поколений системы — экономит место в /boot.
  # Старые можно откатить при загрузке, но обычно хватает 10.
  boot.loader.systemd-boot.configurationLimit = 10;

  # =====================================================================
  # Аварийный доступ (защита от «root is locked» в emergency mode)
  # =====================================================================
  # Контекст проблемы:
  #   Если stage 2 (после разблокировки LUKS) падает в emergency mode,
  #   systemd запускает sulogin и просит ПАРОЛЬ ROOT. Если у root нет
  #   пароля или аккаунт заблокирован — «root is locked», в систему не
  #   попасть без ручной правки параметров ядра в GRUB.
  #
  #   Разовый обход через GRUB (добавить в конец kernel-строки):
  #     single systemd.setenv=SYSTEMD_SULOGIN_FORCE=1
  #   ...работает, но каждый раз набирать руками — плохая привычка.

  # ---------------------------------------------------------------------
  # 1. systemd.debug-shell — «чёрный ход» на Ctrl+Alt+F9
  # ---------------------------------------------------------------------
  # Даёт root-шелл БЕЗ пароля на виртуальной консоли Ctrl+Alt+F9 в любой
  # момент загрузки — даже если система ушла в emergency и sulogin не
  # пускает.
  #
  # Небезопасно при физическом доступе к ноутбуку (любой, кто имеет
  # доступ к клавиатуре, получит root). На личной машине — оправданный
  # компромисс ради того, чтобы не оказаться запертым.
  #
  # Возврат в графическую сессию: Ctrl+Alt+F1 (или F2).
  #
  # В NixOS нет отдельной опции для debug-shell — только параметр ядра.
  boot.kernelParams = [ "systemd.debug-shell" ];

  # ---------------------------------------------------------------------
  # 2. Пароль root — штатный вход через sulogin
  # ---------------------------------------------------------------------
  # Если задан пароль root, emergency mode в stage 2 пустит нормально:
  # sulogin спросит пароль и откроет рут-оболочку. GRUB-костыль не нужен.
  #
  # ВАЖНО: если users.mutableUsers = false (обычная практика в
  # декларативных конфигах NixOS), пароль задаётся только здесь и не
  # может быть изменён командой passwd.
  #
  # ВНИМАНИЕ: значение ниже — ЗАГЛУШКА, не валидный SHA-512 crypt-хэш.
  # Реальный хэш получается так (запрашивает пароль дважды):
  #   openssl passwd -6
  # Формат результата: $6$<соль>$<86 символов base64>
  #
  # В обычных строках Nix "..." символ $ НЕ требует экранирования —
  # только ${ запускает интерполяцию. Здесь её нет, поэтому строка
  # валидна как есть.

  # ---------------------------------------------------------------------
  # 3. emergencyAccess в initrd — страховка на стадии 1
  # ---------------------------------------------------------------------
  # Отдельная история: регулирует аварийный шелл НА СТАДИИ INITRD (до
  # монтирования корня), когда LUKS-пароль не проходит или диск не
  # находится. К «root is locked» в stage 2 отношения не имеет.
  #
  # Значение — хэш пароля (та же команда openssl passwd -6).
  #
  # Раскомментируй и замени на свой хэш:
  #
  # boot.initrd.systemd.emergencyAccess = "$6$...";

  # =====================================================================
  # systemd в initrd (закомментировано — включить при переходе на гибернацию)
  # =====================================================================
  # Включает современный systemd-based initrd вместо legacy bash-скриптов.
  # Критически важно для корректной работы гибернации на LUKS:
  # systemd умеет правильно упорядочивать разблокировку шифрованных
  # устройств и resume из swap. Без этого возможны зависания при
  # пробуждении и долгая загрузка.
  # boot.initrd.systemd.enable = true;

  # =====================================================================
  # Гибернация (закомментировано — включить вместе с systemd в initrd)
  # =====================================================================
  # powerManagement.enable = true;
}

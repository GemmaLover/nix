{ config, lib, pkgs, ... }:

{
  # === Скрипты ===
  # Управление подсветкой клавиатуры реализовано через systemd-сервисы
  # в devices/z13/home-services.nix. Здесь пока пусто.

  # =====================================================================
  # Скрипты: базовые (для всех устройств) подключаются здесь;
  # устройство-специфичные (например, z13-uninstall) живут в
  # devices/<name>/specific/ и НЕ импортируются из base.
  # Папка ./common появится, когда появятся общие скрипты.
  # =====================================================================
  imports = [ ] ++ lib.optionals (builtins.pathExists ./common) [ ./common ];
}

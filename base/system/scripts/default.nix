{ config, lib, pkgs, ... }:

{
  # === Скрипты ===
  # Здесь хранятся скрипты для автоматизации и упрощения работы.

  # --- Скрипт: отключение подсветки клавиатуры через 15 секунд простоя ---
  environment.systemPackages = [
    (pkgs.writeShellScriptBin "keyboard-backlight-idle" ''
      #!/usr/bin/env bash
      # Отключает подсветку клавиатуры ASUS через 15 секунд простоя.
      # Требует asusctl.
      #
      # Логика: если нет активности клавиатуры/тачпада 15 секунд — выключаем подсветку.
      # При любой активности — включаем обратно.

      IDLE_TIMEOUT=15
      BACKLIGHT_LEVEL=1  # 1 — средний уровень, 0 — выключено

      # Функция включения подсветки
      enable_backlight() {
        asusctl -k $BACKLIGHT_LEVEL 2>/dev/null || true
      }

      # Функция выключения подсветки
      disable_backlight() {
        asusctl -k 0 2>/dev/null || true
      }

      # Включаем подсветку при старте
      enable_backlight

      # Мониторим активность через /dev/input
      # При любом событии с клавиатуры или тачпада — сбрасываем таймер
      # Если таймер истёк — выключаем подсветку

      # Используем evtest или аналогичный инструмент
      # Для простоты можно использовать xprintidle или swayidle
      # (зависит от используемого окружения)

      # TODO: Уточнить метод мониторинга активности
    '')
  ];
}
